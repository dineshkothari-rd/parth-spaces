{
  "expo": {
    "name": "Parth Spaces",
    "slug": "kothari-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F172A"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Parth Spaces to photograph meter readings during check-in and check-out.",
          "microphonePermission": false,
          "photosPermission": "Allow Parth Spaces to attach customer and meter photos."
        }
      ],
      "expo-sharing"
    ],
    "ios": {
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.kothari.mobile"
    },
    "android": {
      "allowBackup": false,
      "package": "com.kothari.mobile",
      "versionCode": 8,
      "adaptiveIcon": {
        "backgroundColor": "#ECFEFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "442886ec-3f61-4903-a311-345e47edc797"
      }
    },
    "owner": "dinesh_rd"
  }
}
